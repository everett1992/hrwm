diff --git a/river/XwaylandWindow.zig b/river/XwaylandWindow.zig
index 7d16d97..abfd24e 100644
--- a/river/XwaylandWindow.zig
+++ b/river/XwaylandWindow.zig
@@ -23,6 +23,8 @@ const log = std.log.scoped(.xwayland);
 window: *Window,
 
 xsurface: *wlr.XwaylandSurface,
+/// Whether the ICCCM urgency hint was set in the last WM_HINTS seen
+urgency_hint: bool = false,
 /// Created on map and destroyed on unmap
 surface_tree: ?*wlr.SceneTree = null,
 
@@ -40,6 +42,9 @@ set_decorations: wl.Listener(void) = .init(handleSetDecorations),
 request_maximize: wl.Listener(void) = .init(handleRequestMaximize),
 request_fullscreen: wl.Listener(void) = .init(handleRequestFullscreen),
 request_minimize: wl.Listener(*wlr.XwaylandSurface.event.Minimize) = .init(handleRequestMinimize),
+request_activate: wl.Listener(void) = .init(handleRequestActivate),
+request_demands_attention: wl.Listener(void) = .init(handleRequestDemandsAttention),
+set_hints: wl.Listener(void) = .init(handleSetHints),
 
 // Active while the xsurface is associated with a wlr_surface
 map: wl.Listener(void) = .init(handleMap),
@@ -76,6 +81,9 @@ pub fn create(xsurface: *wlr.XwaylandSurface) error{OutOfMemory}!void {
     xsurface.events.request_maximize.add(&xwindow.request_maximize);
     xsurface.events.request_fullscreen.add(&xwindow.request_fullscreen);
     xsurface.events.request_minimize.add(&xwindow.request_minimize);
+    xsurface.events.request_activate.add(&xwindow.request_activate);
+    xsurface.events.request_demands_attention.add(&xwindow.request_demands_attention);
+    xsurface.events.set_hints.add(&xwindow.set_hints);
 
     if (xsurface.surface) |surface| {
         handleAssociate(&xwindow.associate);
@@ -162,6 +170,9 @@ fn handleDestroy(listener: *wl.Listener(void)) void {
     xwindow.request_maximize.link.remove();
     xwindow.request_fullscreen.link.remove();
     xwindow.request_minimize.link.remove();
+    xwindow.request_activate.link.remove();
+    xwindow.request_demands_attention.link.remove();
+    xwindow.set_hints.link.remove();
 
     xwindow.xsurface.data = null;
 
@@ -344,3 +355,28 @@ fn handleRequestMinimize(
     xwindow.window.wm_scheduled.minimize_requested = true;
     server.wm.dirtyWindowing();
 }
+
+fn handleRequestActivate(listener: *wl.Listener(void)) void {
+    const xwindow: *XwaylandWindow = @fieldParentPtr("request_activate", listener);
+    xwindow.window.wm_scheduled.activation_requested = true;
+    server.wm.dirtyWindowing();
+}
+
+fn handleRequestDemandsAttention(listener: *wl.Listener(void)) void {
+    const xwindow: *XwaylandWindow = @fieldParentPtr("request_demands_attention", listener);
+    if (xwindow.xsurface.demands_attention) {
+        xwindow.window.wm_scheduled.activation_requested = true;
+        server.wm.dirtyWindowing();
+    }
+}
+
+fn handleSetHints(listener: *wl.Listener(void)) void {
+    const xwindow: *XwaylandWindow = @fieldParentPtr("set_hints", listener);
+    // XCB_ICCCM_WM_HINT_X_URGENCY
+    const urgency_hint = if (xwindow.xsurface.hints) |hints| hints.flags & (1 << 8) != 0 else false;
+    if (urgency_hint and !xwindow.urgency_hint) {
+        xwindow.window.wm_scheduled.activation_requested = true;
+        server.wm.dirtyWindowing();
+    }
+    xwindow.urgency_hint = urgency_hint;
+}
